# Quick public landing: no environment variables required.
# Default is 'landing': only the editorial homepage is exposed.
# To enable work-in-progress routes after deploying the backend, set:
# STEALTHBRIDGE_SITE_MODE=preview
# STEALTHBRIDGE_API_URL=https://your-deployed-backend.example
# Local preview only: STEALTHBRIDGE_API_URL=http://localhost:8080

# Enable only after the backend instruction migration and matching backend flag.
STEALTHBRIDGE_PAYMENT_INSTRUCTIONS_ENABLED=false
# Reuse the existing server-only account bridge secret; never expose to the browser.
# STEALTHBRIDGE_ACCOUNT_BRIDGE_SECRET=
